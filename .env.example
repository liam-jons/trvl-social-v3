# =================================================================
# TRVL SOCIAL V3 ENVIRONMENT VARIABLES TEMPLATE
# =================================================================
# This file contains all environment variables required for the application.
# Copy this file to .env.local and fill in the values for local development.
# For production, configure these variables in your hosting provider's dashboard.
#
# SECURITY: Never commit .env.local or any file containing real credentials!
# =================================================================

# =================================================================
# SUPABASE CONFIGURATION (REQUIRED)
# =================================================================
# Your Supabase project configuration
# Find these in your Supabase project dashboard under Settings > API

# The unique identifier for your Supabase project
# Example: "abcdefghijklmnopqrst"
VITE_SUPABASE_PROJECT_ID=

# The public/anon API key for client-side operations (safe to expose)
# This is the "anon" or "public" key from Supabase project settings
# Example: "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
VITE_SUPABASE_PUBLISHABLE_KEY=

# The URL for your Supabase project API
# Example: "https://abcdefghijklmnopqrst.supabase.co"
VITE_SUPABASE_URL=

# The service role key for server-side operations (KEEP SECRET!)
# Only use in secure server environments, never expose to client
# Example: "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY=

# =================================================================
# STRIPE PAYMENT CONFIGURATION (REQUIRED)
# =================================================================
# Stripe API keys for payment processing
# Find these in your Stripe dashboard under Developers > API keys

# Publishable key for client-side Stripe operations (safe to expose)
# Use test key for development: pk_test_...
# Use live key for production: pk_live_...
VITE_STRIPE_PUBLISHABLE_KEY=

# Secret key for server-side Stripe operations (KEEP SECRET!)
# Use test key for development: sk_test_...
# Use live key for production: sk_live_...
STRIPE_SECRET_KEY=

# Webhook endpoint secret for verifying Stripe webhooks
# Find in Stripe dashboard under Webhooks > Your endpoint > Signing secret
# Example: "whsec_..."
STRIPE_WEBHOOK_SECRET=

# Stripe Connect client ID for marketplace functionality
# Find in Stripe dashboard under Connect > Settings
# Example: "ca_..."
STRIPE_CONNECT_CLIENT_ID=

# =================================================================
# APPLICATION CONFIGURATION (REQUIRED)
# =================================================================

# The base URL where your application is hosted
# Local: "http://localhost:5173"
# Staging: "https://staging.trvlsocial.com"
# Production: "https://trvlsocial.com"
VITE_APP_URL=http://localhost:5173

# Application name displayed throughout the UI
VITE_APP_NAME="TRVL Social"

# Application version (for tracking deployments)
VITE_APP_VERSION=3.0.0

# Build number (incremented with each build)
VITE_BUILD_NUMBER=1

# Node environment (development, staging, production)
# Automatically set by most build tools
NODE_ENV=development

# =================================================================
# MAPS AND LOCATION SERVICES (REQUIRED)
# =================================================================
# Mapbox configuration for map features
# Get your token from https://www.mapbox.com/account/access-tokens

# Mapbox public access token (safe to expose)
# Example: "pk.eyJ1..."
VITE_MAPBOX_ACCESS_TOKEN=

# =================================================================
# WHATSAPP INTEGRATION (OPTIONAL)
# =================================================================
# WhatsApp Business API configuration
# Required only if using WhatsApp messaging features

# Base URL for WhatsApp Graph API
VITE_WHATSAPP_API_BASE_URL=https://graph.facebook.com/v18.0

# Permanent access token for WhatsApp Business API
# Generate from Facebook Business Manager
VITE_WHATSAPP_ACCESS_TOKEN=

# WhatsApp Business phone number ID
# Find in Facebook Business Manager
VITE_WHATSAPP_PHONE_NUMBER_ID=

# Webhook verification token for WhatsApp webhooks
# You create this - use a secure random string
VITE_WHATSAPP_VERIFY_TOKEN=

# Webhook secret for validating WhatsApp webhook payloads
# You create this - use a secure random string
WHATSAPP_WEBHOOK_SECRET=

# =================================================================
# VIDEO CONFERENCING (OPTIONAL)
# =================================================================
# Daily.co configuration for video calling features
# Sign up at https://daily.co to get API credentials

# Daily.co API key for creating video rooms
VITE_DAILY_API_KEY=

# Daily.co secret key for server-side operations
DAILY_API_SECRET=

# =================================================================
# ANALYTICS & MONITORING (RECOMMENDED)
# =================================================================

# Sentry Error Tracking & Performance Monitoring
# Get your DSN from https://sentry.io
VITE_SENTRY_DSN=

# Sentry environment (development, staging, production)
VITE_SENTRY_ENVIRONMENT=development

# Sentry traces sample rate (0.0 to 1.0)
# 0.1 = 10% of transactions, 1.0 = 100% of transactions
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# Sentry Auth Token (for GDPR data removal)
# Get from Sentry organization settings
SENTRY_AUTH_TOKEN=

# Sentry Organization Slug
SENTRY_ORG=

# Google Analytics 4
# Get your measurement ID from Google Analytics
VITE_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# Mixpanel Analytics
# Get your project token from https://mixpanel.com
VITE_MIXPANEL_TOKEN=

# Mixpanel Project Token (for server-side operations)
MIXPANEL_PROJECT_TOKEN=

# Mixpanel API Secret (for GDPR data deletion)
# Get from Mixpanel project settings
MIXPANEL_API_SECRET=

# Datadog Real User Monitoring (Optional)
# Get credentials from https://datadoghq.com
VITE_DATADOG_APPLICATION_ID=
VITE_DATADOG_CLIENT_TOKEN=
VITE_DATADOG_SITE=datadoghq.com
VITE_DATADOG_SERVICE=trvl-social-v3
VITE_DATADOG_VERSION=3.0.0

# =================================================================
# AI SERVICES (OPTIONAL)
# =================================================================
# API keys for AI features (content moderation, recommendations, etc.)

# Anthropic Claude API for AI features
# Get from https://console.anthropic.com
ANTHROPIC_API_KEY=
VITE_ANTHROPIC_API_KEY=

# OpenAI API for AI features
# Get from https://platform.openai.com
OPENAI_API_KEY=
VITE_OPENAI_API_KEY=

# Perplexity API for search features
# Get from https://perplexity.ai
PERPLEXITY_API_KEY=

# =================================================================
# EMAIL SERVICE (REQUIRED FOR GDPR FEATURES)
# =================================================================
# Email service configuration for transactional emails
# Using Resend, SendGrid, or similar service
# REQUIRED for data export notifications

# Resend API Key
# Get from https://resend.com
RESEND_API_KEY=

# Email "from" address
# Must be verified with your email service provider
EMAIL_FROM_ADDRESS=noreply@trvlsocial.com

# Email "from" name
EMAIL_FROM_NAME="TRVL Social"

# =================================================================
# FEATURE FLAGS (OPTIONAL)
# =================================================================
# Control feature availability across environments
# Convention: VITE_FEATURE_[FEATURE_NAME]
# Values: "true" or "false" (as strings)

# Enable vendor forum v2 features
VITE_FEATURE_VENDOR_FORUM_V2=false

# Enable group video calls
VITE_FEATURE_GROUP_VIDEO_CALLS=false

# Enable AI-powered trip recommendations
VITE_FEATURE_AI_RECOMMENDATIONS=false

# Enable beta features for testing
VITE_FEATURE_BETA=false

# =================================================================
# MONITORING THRESHOLDS (OPTIONAL)
# =================================================================
# Performance monitoring thresholds for alerting

# Core Web Vitals Thresholds (in milliseconds)
VITE_LCP_WARNING_THRESHOLD=2500
VITE_LCP_CRITICAL_THRESHOLD=4000
VITE_FID_WARNING_THRESHOLD=100
VITE_FID_CRITICAL_THRESHOLD=300
VITE_CLS_WARNING_THRESHOLD=0.1
VITE_CLS_CRITICAL_THRESHOLD=0.25

# Performance Thresholds
VITE_RESPONSE_TIME_WARNING=500
VITE_RESPONSE_TIME_CRITICAL=1000
VITE_ERROR_RATE_WARNING=1
VITE_ERROR_RATE_CRITICAL=5

# Business Metrics Thresholds
VITE_CONVERSION_RATE_WARNING=2
VITE_CONVERSION_RATE_CRITICAL=1
VITE_BOUNCE_RATE_WARNING=70
VITE_BOUNCE_RATE_CRITICAL=80

# =================================================================
# NOTIFICATION CONFIGURATION (OPTIONAL)
# =================================================================
# Configuration for alert notifications

# Slack Webhook for Critical Alerts
VITE_SLACK_WEBHOOK_URL=

# Email for Alert Notifications
VITE_ALERT_EMAIL=alerts@trvlsocial.com

# =================================================================
# DEVELOPMENT TOOLS (DEVELOPMENT ONLY)
# =================================================================
# Tools and services used only during development

# Enable React Query Devtools
VITE_ENABLE_DEVTOOLS=true

# Enable debug mode in development
VITE_DEBUG_MODE=false

# Enable verbose logging in development
VITE_VERBOSE_LOGGING=false

# Disable analytics in development
VITE_DISABLE_ANALYTICS_IN_DEV=true

# Mock API responses (for offline development)
VITE_USE_MOCK_API=false

# =================================================================
# DEPLOYMENT & CI/CD (REQUIRED FOR DEPLOYMENT)
# =================================================================
# Configuration for deployment pipelines

# Vercel deployment token (for CI/CD)
# Get from https://vercel.com/account/tokens
VERCEL_TOKEN=

# Vercel project ID
# Find in Vercel project settings
VERCEL_PROJECT_ID=

# Vercel organization ID
# Find in Vercel team settings
VERCEL_ORG_ID=

# GitHub personal access token (for automated deployments)
# Create at https://github.com/settings/tokens
GITHUB_TOKEN=

# =================================================================
# DATABASE MIGRATIONS (CI/CD ONLY)
# =================================================================
# Used by CI/CD pipeline for database migrations

# Database connection string for migrations
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=

# Shadow database URL for migration testing
# Same format as DATABASE_URL
SHADOW_DATABASE_URL=

# =================================================================
# RATE LIMITING & SECURITY (PRODUCTION ONLY)
# =================================================================

# Rate limit configuration
# Maximum requests per IP per minute
RATE_LIMIT_MAX_REQUESTS=100

# Rate limit window in minutes
RATE_LIMIT_WINDOW_MINUTES=1

# CORS allowed origins (comma-separated)
# Example: "https://trvlsocial.com,https://app.trvlsocial.com"
CORS_ALLOWED_ORIGINS=

# Content Security Policy directives
# Configure based on your security requirements
CSP_DIRECTIVES=

# Session secret for cookie signing (generate a random string)
SESSION_SECRET=

# JWT secret for token signing (generate a random string)
JWT_SECRET=

# =================================================================
# GDPR & DATA PRIVACY (REQUIRED)
# =================================================================
# Configuration for GDPR compliance features (Task #46)

# Encryption key for birth date storage (minimum 32 characters)
# Generate a secure random string and keep it secret
# Used by age verification and secure credential services
BIRTH_DATE_ENCRYPTION_KEY=

# =================================================================
# NOTES
# =================================================================
# 1. Required variables must be set for the application to start
# 2. Optional variables enable additional features
# 3. Use test/development keys for local development
# 4. Use production keys only in secure production environment
# 5. Rotate secrets regularly according to security best practices
# 6. Document any custom environment variables in this file
#
# For secrets rotation procedures, see SECRETS_MANAGEMENT.md
# For environment setup guide, see README.md#environment-configuration
# =================================================================